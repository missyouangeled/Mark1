[Unit]
Description=Mark42 Autonomy Decision Engine
After=openclaw-gateway.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /home/missyouangeled/.openclaw/workspace/scripts/autonomy/autonomy.py --check
Environment=OPENCLAW_WORKSPACE=/home/missyouangeled/.openclaw/workspace
Environment=PATH=/home/missyouangeled/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
