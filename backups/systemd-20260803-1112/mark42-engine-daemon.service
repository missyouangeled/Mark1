# TEMPLATE FILE — 需先渲染 __MARK42_* 占位符，再安装到 ~/.config/systemd/user/
[Unit]
Description=Mark42 Engine Daemon — 循环引擎守护进程
# 【2026-07-31 P1 加固】BindsTo 让 engine-daemon 跟 openclaw-gateway 绑定
BindsTo=openclaw-gateway.service
After=openclaw-gateway.service
Wants=openclaw-gateway.service
Requires=mark42-bootstrap.service
# 【2026-07-31 P1 加固】RefuseManualStop 拒绝手动 stop
RefuseManualStop=yes
# 【2026-07-31 P1 加固】限制重启频率：60 秒内最多 5 次
# StartLimit* 必须在 [Unit] 段不在 [Service] 段
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=MARK42_WORKSPACE=/home/missyouangeled/.openclaw/workspace
Environment=MARK42_PYTHON_BIN=python3
Environment=XDG_STATE_HOME=/home/missyouangeled/.local/state
Environment=MARK42_STATE_DIR=/home/missyouangeled/.local/state/openclaw/mark42
Environment=MARK42_LOG_DIR=/home/missyouangeled/.local/state/openclaw/mark42/logs
Environment=MARK42_SCRATCH=/mnt/data/openclaw/scratch
ExecStart=python3 -u -m mark42 engine --daemon --interval 30
ExecStop=/bin/sh -c 'test -n "$MAINPID" && kill -TERM "$MAINPID" || true'
Restart=always
RestartSec=10
StandardOutput=append:/home/missyouangeled/.local/state/openclaw/mark42/logs/engine-daemon.log
StandardError=append:/home/missyouangeled/.local/state/openclaw/mark42/logs/engine-daemon.log
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
WantedBy=openclaw-gateway.service
