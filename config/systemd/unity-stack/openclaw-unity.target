# 适用机器：公司（Linux VM）
# 系统 / OS：Linux（systemd --user）
# 建立日期：2026-08-06
#
# 用途：Unity 连接栈的【总开关】。
#       罩住两个成员服务：
#         - openclaw-unity-bridge.service  (老 Bridge，端口 27182)
#         - openclaw-unity-mcp.service     (CoplayDev MCP，端口 8080)
#
# 设计意图（点点 2026-08-06 要求）：
#   「写成一个模块，开机自动启动，做成补丁那种，删掉就都删掉，开启就都开启。」
#
#   所以：
#     start  openclaw-unity.target  → 两个服务一起起
#     stop   openclaw-unity.target  → 两个服务一起停（靠成员的 PartOf=）
#     enable openclaw-unity.target  → 开机自启（WantedBy=default.target）
#     卸载脚本删 target + 两个 service → 整个模块干净消失
#
# ⚠️ 不要把成员服务单独 enable。统一由本 target 拉起，
#    这样才能保证「一个开关管两个」，不出现半启动状态。

[Unit]
Description=OpenClaw Unity 连接栈（Bridge 27182 + MCP 8080）
# 文档（systemd 不接受非 ASCII 的 file:// URL，故以注释形式记录）：
#   docs/通用-Unity-Bridge-连接指南.md
#   docs/通用-Unity-MCP-CoplayDev-使用指南.md

# 两个成员服务由各自的 WantedBy= 挂进来（见 .service 的 [Install] 段）。
# 这里不写 Wants=，避免与 enable 生成的符号链接重复维护。

[Install]
WantedBy=default.target
